{
  "name": "pdv-unificado",
  "version": "1.0.0",
  "description": "Sistema PDV com Servidor e Painel de Controle",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^24.22.3",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  },
  "build": {
    "appId": "com.pdvweb.unificado",
    "productName": "PDV Unificado",
    "files": [
      "src/**/*",
      "main.js",
      "control-panel.html",
      "control-panel.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "database.sqlite",
        "to": "database.sqlite"
      },
      {
        "from": "../frontend/cadastro-funcionarios/build",
        "to": "frontend/cadastro-funcionarios/build"
      }
    ],
    "asarUnpack": [
      "**/node_modules/puppeteer/**"
    ]
  }
}